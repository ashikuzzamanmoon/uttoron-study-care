# ==========================================
# Uttoron Study Care — Monorepo .gitignore
# ==========================================

# Dependencies
node_modules/
*/node_modules/
.pnp
.pnp.js

# Production & Build outputs
dist/
*/dist/
.next/
*/.next/
out/
*/out/
build/
*/build/

# TypeScript cache
*.tsbuildinfo
*/tsconfig.build.tsbuildinfo

# Environment variables (keep secrets out of git)
.env
.env.local
.env.*.local
*.env
backend/.env
frontend/.env.local

# Allow example env files
!.env.example
!backend/.env.example
!frontend/.env.example

# Logs & Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.log

# Editor & OS files
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Testing & Coverage
coverage/
*/coverage/
.nyc_output

# Temporary & Upload files
uploads/
*/uploads/
tmp/
temp/
*.tmp
