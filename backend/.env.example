# Database
DATABASE_URL="postgresql://username:password@localhost:5432/uttoron_db?schema=public"

# JWT Configuration
JWT_SECRET="your-super-secret-jwt-key"
JWT_EXPIRES_IN="1d"
JWT_REFRESH_SECRET="your-super-refresh-jwt-key"
JWT_REFRESH_EXPIRES_IN="7d"

# Server Configuration
PORT=5000
NODE_ENV=development

# SMS Gateway Configuration
SMS_GATEWAY_URL="http://api.greenweb.com.bd/api.php"
SMS_GATEWAY_API_KEY="your-sms-api-key"
SMS_SENDER_ID="UTTORON"
